# ==============================================================================
# CONFIGURACIÓN PARA HOSTINGER (PRODUCCIÓN)
# ==============================================================================
# Copia o renombra este archivo como ".env" en la raíz de tu proyecto en Hostinger
# y rellena con los datos creados en tu hPanel de Hostinger.

# Puerto del servidor (Hostinger lo asigna automáticamente o puedes usar 4000/3000)
PORT=4000

# Entorno de ejecución
NODE_ENV=production

# Clave secreta para generación de tokens de sesión JWT
JWT_SECRET=elite_studio_super_secret_jwt_key_hostinger_2026

# ==============================================================================
# BASE DE DATOS REMOTA (MySQL / Hostinger hPanel / phpMyAdmin)
# ==============================================================================
# Tipo de base de datos: 'mysql' para Hostinger
DB_TYPE=mysql

# Host de la base de datos (En Hostinger casi siempre es "localhost" o "127.0.0.1")
DB_HOST=localhost

# Puerto MySQL (Por defecto 3306)
DB_PORT=3306

# Nombre del usuario de MySQL creado en Hostinger (ej: u123456789_admin)
DB_USER=tu_usuario_mysql_hostinger

# Contraseña del usuario de MySQL asignada en Hostinger
DB_PASSWORD=tu_password_mysql_hostinger

# Nombre de la base de datos creada en Hostinger (ej: u123456789_elitedb)
DB_NAME=tu_base_de_datos_hostinger

# ==============================================================================
# BASE DE DATOS LOCAL OPCIONAL (SQLite)
# ==============================================================================
# Solo si DB_TYPE=sqlite o si se ejecuta en local sin MySQL
DATABASE_PATH=./data/elite_pos.db
