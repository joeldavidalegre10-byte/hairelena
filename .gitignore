# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment Variables & Secrets (Keep real .env out of version control)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
backend/.env
*.env.local

# Allow example environment files
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
